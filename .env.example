PORT=4000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=signalwrite

# AI_MODE: free (no AI calls), openai (any OpenAI-compatible API, e.g. Groq), or ollama (local).
AI_MODE=openai
OPENAI_API_KEY=
# Leave empty for OpenAI itself. For Groq use https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
# Optional, only for reasoning models such as openai/gpt-oss-*
# OPENAI_MAX_TOKENS=8192
# OPENAI_REASONING_EFFORT=low

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:1b-instruct-q2_K
OLLAMA_MAX_TOKENS=1200

# Optional external web research (tavily.com). Without this, topics come from your site pages only.
TAVILY_API_KEY=
