PORT=4000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=signalwrite

# AI_MODE: free (no AI calls), openai (any OpenAI-compatible API, e.g. Groq), or ollama (local).
AI_MODE=openai
OPENAI_API_KEY=
# Leave empty for OpenAI itself. For Groq use https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
# Optional, only for reasoning models such as openai/gpt-oss-*
# OPENAI_MAX_TOKENS=8192
# OPENAI_REASONING_EFFORT=low

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:1b-instruct-q2_K
OLLAMA_MAX_TOKENS=1200

# Optional external web research (tavily.com). Without this, topics come from your site pages only.
TAVILY_API_KEY=

# Rate limits (protect your Groq/Tavily credits). AI routes are counted per account per hour,
# plus a daily limit per account and one daily total for the whole tool. Defaults shown.
RATE_LIMIT_ANALYZE_PER_HOUR=15
RATE_LIMIT_ARTICLES_PER_HOUR=30
RATE_LIMIT_DAILY_PER_USER=60
RATE_LIMIT_DAILY_TOTAL=1000
RATE_LIMIT_SIGNUPS_PER_HOUR=5
RATE_LIMIT_LOGINS_PER_15MIN=10
# Behind nginx/Apache on the same server the default (loopback) is right. Behind a cloud
# load balancer set this to 1 so limits use the visitor's real IP.
# TRUST_PROXY=1

# ---- Accounts & subscription ----
# Your own team's emails (comma separated): always free full access + the Admin page.
# Sign up in the app with one of these emails to become admin.
ADMIN_EMAILS=
# Free trial length for new sign-ups, in days.
TRIAL_DAYS=14
# Shown to customers whose trial ended.
PLAN_PRICE=₹999/month
# How customers reach you to subscribe (email, phone or WhatsApp), shown when the trial ends.
SUBSCRIBE_CONTACT=
# Optional: secret for signing login cookies. If empty, one is generated and kept in the database.
SESSION_SECRET=
